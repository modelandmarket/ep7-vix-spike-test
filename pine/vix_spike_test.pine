//@version=5
// M&M EP7: Buy the VIX Spike
// Paste into TradingView Pine Editor on a SPY daily chart.
// Rule: buy SPY when VIX close >= trigger; exit when VIX < exitLevel or maxHold days.
// Compare against Buy & Hold in the Strategy Tester tab.
// Note: TVC:VIX and Yahoo ^VIX can differ on borderline days (exactly 40.0),
// so trade counts may differ by 1-2 vs other engines.

strategy("M&M EP7: VIX Spike Test", overlay=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.05, pyramiding=0)

vix = request.security("TVC:VIX", "D", close)

T = input.int(40, "VIX trigger threshold")
exitLevel = input.int(20, "VIX exit level")
maxHold = input.int(63, "Max hold (trading days)")

var int barsHeld = 0

entryOK = vix >= T and strategy.position_size == 0

if entryOK
    strategy.entry("Long", strategy.long)
    barsHeld := 0

if strategy.position_size > 0
    barsHeld += 1
    if vix < exitLevel or barsHeld >= maxHold
        strategy.close("Long", comment="exit: calm or maxHold")

plot(strategy.position_size > 0 ? vix : na, "In position (VIX)", color=color.new(color.orange, 0), linewidth=2)
plotchar(entryOK ? vix : na, "Trigger", char="T", location=location.belowbar, size=size.small, color=color.new(color.red, 0))
